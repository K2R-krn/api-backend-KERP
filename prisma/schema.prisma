datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// Phase 0 — Foundation (TDD §5)
// ============================================================================

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username           String
  passwordHash       String    @map("password_hash")
  name               String
  role               String
  email              String?
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  userBranches    UserBranch[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  idempotencyKeys IdempotencyKey[]

  @@index([username])
  @@index([email])
  @@map("users")
}

model Branch {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  code         String
  gstin        String?
  stateCode    String  @map("state_code")
  address      String?
  phone        String?
  isActive     Boolean @default(true) @map("is_active")
  cashLedgerId String? @map("cash_ledger_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  userBranches      UserBranch[]
  auditLogs         AuditLog[]
  numberSeries      NumberSeries[]
  ledgers           Ledger[]           @relation("BranchOwnLedgers")
  cashLedger        Ledger?            @relation("BranchCashLedger", fields: [cashLedgerId], references: [id])
  branchStock       BranchStock[]
  parties           Party[]
  sales             Sale[]
  saleLineItems     SaleLineItem[]
  purchases         Purchase[]
  purchaseLineItems PurchaseLineItem[]
  payments          Payment[]
  ledgerPostings    LedgerPosting[]
  stockMovements    StockMovement[]

  @@index([code])
  @@index([cashLedgerId])
  @@map("branches")
}

model UserBranch {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user   User?   @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([entityType, entityId])
  @@index([branchId, createdAt])
  @@map("audit_logs")
}

model NumberSeries {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String  @map("branch_id") @db.Uuid
  voucherType   String  @map("voucher_type")
  financialYear String  @map("financial_year")
  prefix        String?
  currentNumber Int     @default(0) @map("current_number")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, voucherType, financialYear])
  @@map("number_series")
}

model CompanyProfile {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessName      String  @map("business_name")
  legalName         String? @map("legal_name")
  logoUrl           String? @map("logo_url")
  invoiceTerms      String? @map("invoice_terms")
  invoiceFooter     String? @map("invoice_footer")
  roundingMode      String  @default("none") @map("rounding_mode")
  fyStartMonth      Int     @default(4) @map("fy_start_month")
  salesLedgerId     String? @map("sales_ledger_id") @db.Uuid
  purchasesLedgerId String? @map("purchases_ledger_id") @db.Uuid
  cgstLedgerId      String? @map("cgst_ledger_id") @db.Uuid
  sgstLedgerId      String? @map("sgst_ledger_id") @db.Uuid
  igstLedgerId      String? @map("igst_ledger_id") @db.Uuid
  roundOffLedgerId  String? @map("round_off_ledger_id") @db.Uuid
  // CC-7 applied one level up: confirmPayment (TDD §31.1) validates a caller-supplied
  // cash_bank_ledger_id belongs to specifically the Cash-in-Hand or Bank Accounts seeded groups
  // (§6.1), never nature='asset' generally. Resolved ONCE by seed.ts (by name, the same one-time
  // offline resolution every other system-ledger FK here already uses) and stored — the service
  // itself only ever compares against these stored ids, never does a live name lookup.
  cashAccountGroupId String? @map("cash_account_group_id") @db.Uuid
  bankAccountGroupId String? @map("bank_account_group_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  salesLedger     Ledger? @relation("CompanyProfileSalesLedger", fields: [salesLedgerId], references: [id])
  purchasesLedger Ledger? @relation("CompanyProfilePurchasesLedger", fields: [purchasesLedgerId], references: [id])
  cgstLedger      Ledger? @relation("CompanyProfileCgstLedger", fields: [cgstLedgerId], references: [id])
  sgstLedger      Ledger? @relation("CompanyProfileSgstLedger", fields: [sgstLedgerId], references: [id])
  igstLedger      Ledger? @relation("CompanyProfileIgstLedger", fields: [igstLedgerId], references: [id])
  roundOffLedger  Ledger? @relation("CompanyProfileRoundOffLedger", fields: [roundOffLedgerId], references: [id])
  cashAccountGroup AccountGroup? @relation("CompanyProfileCashAccountGroup", fields: [cashAccountGroupId], references: [id])
  bankAccountGroup AccountGroup? @relation("CompanyProfileBankAccountGroup", fields: [bankAccountGroupId], references: [id])

  @@index([salesLedgerId])
  @@index([purchasesLedgerId])
  @@index([cgstLedgerId])
  @@index([sgstLedgerId])
  @@index([igstLedgerId])
  @@index([roundOffLedgerId])
  @@index([cashAccountGroupId])
  @@index([bankAccountGroupId])
  @@map("company_profile")
}

// ============================================================================
// Phase 1 — Masters (TDD §6)
// ============================================================================

model AccountGroup {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  tallyEquivalent String? @map("tally_equivalent")
  nature          String
  parentGroupId   String? @map("parent_group_id") @db.Uuid
  isSystem        Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  parentGroup AccountGroup?  @relation("AccountGroupHierarchy", fields: [parentGroupId], references: [id])
  childGroups AccountGroup[] @relation("AccountGroupHierarchy")
  ledgers     Ledger[]

  companyProfilesAsCashGroup CompanyProfile[] @relation("CompanyProfileCashAccountGroup")
  companyProfilesAsBankGroup CompanyProfile[] @relation("CompanyProfileBankAccountGroup")

  @@index([parentGroupId])
  @@map("account_groups")
}

model Ledger {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  accountGroupId String  @map("account_group_id") @db.Uuid
  branchId       String? @map("branch_id") @db.Uuid
  openingBalance BigInt  @default(0) @map("opening_balance")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  accountGroup AccountGroup @relation(fields: [accountGroupId], references: [id])
  branch       Branch?      @relation("BranchOwnLedgers", fields: [branchId], references: [id])
  parties      Party[]

  salesAsBankLedger          Sale[]
  purchasesAsBankLedger      Purchase[]
  paymentsAsCashBank         Payment[]        @relation("PaymentCashBankLedger")
  paymentsAsCounterLedger    Payment[]        @relation("PaymentCounterLedger")
  ledgerPostings             LedgerPosting[]
  branchesUsingAsCash        Branch[]         @relation("BranchCashLedger")
  companyProfilesAsSales     CompanyProfile[] @relation("CompanyProfileSalesLedger")
  companyProfilesAsPurchases CompanyProfile[] @relation("CompanyProfilePurchasesLedger")
  companyProfilesAsCgst      CompanyProfile[] @relation("CompanyProfileCgstLedger")
  companyProfilesAsSgst      CompanyProfile[] @relation("CompanyProfileSgstLedger")
  companyProfilesAsIgst      CompanyProfile[] @relation("CompanyProfileIgstLedger")
  companyProfilesAsRoundOff  CompanyProfile[] @relation("CompanyProfileRoundOffLedger")

  @@index([accountGroupId])
  @@index([branchId])
  @@map("ledgers")
}

model Unit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  symbol           String
  baseUnitId       String?  @map("base_unit_id") @db.Uuid
  conversionFactor Decimal? @map("conversion_factor") @db.Decimal(12, 4)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  baseUnit Unit?     @relation("UnitConversion", fields: [baseUnitId], references: [id])
  variants Unit[]    @relation("UnitConversion")
  products Product[]

  @@index([baseUnitId])
  @@map("units")
}

model Category {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  parentId                 String?  @map("parent_id") @db.Uuid
  defaultGstRate           Decimal? @map("default_gst_rate") @db.Decimal(5, 2)
  defaultTaxClassification String?  @map("default_tax_classification")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  hsnCode           String? @map("hsn_code")
  sku               String?
  categoryId        String? @map("category_id") @db.Uuid
  unitId            String  @map("unit_id") @db.Uuid
  gstRate           Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  priceIncludesGst  Boolean @default(false) @map("price_includes_gst")
  taxClassification String  @default("taxable") @map("tax_classification")
  purchasePrice     BigInt  @default(0) @map("purchase_price")
  salePrice         BigInt  @default(0) @map("sale_price")
  mrp               BigInt?
  isActive          Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  category    Category?     @relation(fields: [categoryId], references: [id])
  unit        Unit          @relation(fields: [unitId], references: [id])
  branchStock BranchStock[]

  saleLineItems     SaleLineItem[]
  purchaseLineItems PurchaseLineItem[]
  stockMovements    StockMovement[]

  @@index([categoryId])
  @@index([unitId])
  @@index([name])
  @@index([hsnCode])
  @@map("products")
}

model BranchStock {
  branchId          String   @map("branch_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  quantity          Decimal  @default(0) @db.Decimal(12, 3)
  avgCost           BigInt   @default(0) @map("avg_cost")
  lowStockThreshold Decimal? @map("low_stock_threshold") @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([branchId, productId])
  @@index([productId])
  @@map("branch_stock")
}

model Party {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           String
  name           String
  village        String
  mobile         String?
  email          String?
  gstin          String?
  stateCode      String  @map("state_code")
  address        String?
  ledgerId       String  @map("ledger_id") @db.Uuid
  owningBranchId String  @map("owning_branch_id") @db.Uuid
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  ledger       Ledger @relation(fields: [ledgerId], references: [id])
  owningBranch Branch @relation(fields: [owningBranchId], references: [id])

  salesAsCustomer             Sale[]
  saleLineItemsAsCustomer     SaleLineItem[]
  purchasesAsSupplier         Purchase[]
  purchaseLineItemsAsSupplier PurchaseLineItem[]
  paymentsAsParty             Payment[]

  @@index([ledgerId])
  @@index([owningBranchId])
  @@index([name, village])
  @@map("parties")
}

// ============================================================================
// Iteration 2 additions (TDD §11.3, §14.1)
// ============================================================================

model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz()
  userAgent     String?   @map("user_agent")
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user        User           @relation(fields: [userId], references: [id])
  rotatedFrom RefreshToken?  @relation("RefreshTokenRotation", fields: [rotatedFromId], references: [id])
  rotatedTo   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([tokenHash])
  @@index([rotatedFromId])
  @@map("refresh_tokens")
}

model IdempotencyKey {
  key         String   @id
  userId      String   @map("user_id") @db.Uuid
  scope       String
  requestHash String   @map("request_hash")
  status      String
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt   DateTime @map("expires_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("idempotency_keys")
}

// ============================================================================
// Iteration 3 — Transactions (TDD §24-29)
// ============================================================================

model Sale {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId               String    @map("branch_id") @db.Uuid
  customerId             String?   @map("customer_id") @db.Uuid
  customerName           String    @map("customer_name")
  customerVillage        String    @map("customer_village")
  voucherDate            DateTime  @map("voucher_date") @db.Date
  status                 String    @default("draft")
  invoiceNumber          String?   @map("invoice_number")
  financialYear          String?   @map("financial_year")
  placeOfSupplyStateCode String?   @map("place_of_supply_state_code")
  documentType           String?   @map("document_type")
  totalTaxable           BigInt    @default(0) @map("total_taxable")
  totalDiscount          BigInt    @default(0) @map("total_discount")
  totalCgst              BigInt    @default(0) @map("total_cgst")
  totalSgst              BigInt    @default(0) @map("total_sgst")
  totalIgst              BigInt    @default(0) @map("total_igst")
  roundOff               BigInt    @default(0) @map("round_off")
  grandTotal             BigInt    @default(0) @map("grand_total")
  paidCash               BigInt    @default(0) @map("paid_cash")
  paidBank               BigInt    @default(0) @map("paid_bank")
  creditUdhar            BigInt    @default(0) @map("credit_udhar")
  bankLedgerId           String?   @map("bank_ledger_id") @db.Uuid
  notes                  String?
  cancelReason           String?   @map("cancel_reason")
  cancelledAt            DateTime? @map("cancelled_at") @db.Timestamptz()
  cancelledBy            String?   @map("cancelled_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  branch             Branch              @relation(fields: [branchId], references: [id])
  customer           Party?              @relation(fields: [customerId], references: [id])
  bankLedger         Ledger?             @relation(fields: [bankLedgerId], references: [id])
  lineItems          SaleLineItem[]
  paymentAllocations PaymentAllocation[]

  @@index([branchId, voucherDate])
  @@index([customerId, voucherDate])
  @@index([bankLedgerId])
  @@map("sales")
}

model SaleLineItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId            String   @map("sale_id") @db.Uuid
  lineNumber        Int      @map("line_number")
  productId         String   @map("product_id") @db.Uuid
  customerId        String?  @map("customer_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  saleDate          DateTime @map("sale_date") @db.Date
  unitRate          BigInt   @map("unit_rate")
  billedQty         Decimal  @map("billed_qty") @db.Decimal(12, 3)
  freeQty           Decimal  @default(0) @map("free_qty") @db.Decimal(12, 3)
  discount          BigInt   @default(0)
  gstRate           Decimal  @map("gst_rate") @db.Decimal(5, 2)
  priceIncludesGst  Boolean  @map("price_includes_gst")
  taxClassification String   @map("tax_classification")
  hsnCode           String?  @map("hsn_code")
  productName       String?  @map("product_name")
  unitSymbol        String?  @map("unit_symbol")
  taxableValue      BigInt   @map("taxable_value")
  cgstAmount        BigInt   @default(0) @map("cgst_amount")
  sgstAmount        BigInt   @default(0) @map("sgst_amount")
  igstAmount        BigInt   @default(0) @map("igst_amount")
  lineTotal         BigInt   @map("line_total")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  sale     Sale    @relation(fields: [saleId], references: [id])
  product  Product @relation(fields: [productId], references: [id])
  customer Party?  @relation(fields: [customerId], references: [id])
  branch   Branch  @relation(fields: [branchId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([branchId])
  @@index([customerId, productId, saleDate(sort: Desc)])
  @@map("sale_line_items")
}

model Purchase {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId              String    @map("branch_id") @db.Uuid
  supplierId            String    @map("supplier_id") @db.Uuid
  voucherDate           DateTime  @map("voucher_date") @db.Date
  status                String    @default("draft")
  voucherNumber         String?   @map("voucher_number")
  financialYear         String?   @map("financial_year")
  supplierInvoiceNumber String?   @map("supplier_invoice_number")
  supplierInvoiceDate   DateTime? @map("supplier_invoice_date") @db.Date
  totalTaxable          BigInt    @default(0) @map("total_taxable")
  totalDiscount         BigInt    @default(0) @map("total_discount")
  totalCgst             BigInt    @default(0) @map("total_cgst")
  totalSgst             BigInt    @default(0) @map("total_sgst")
  totalIgst             BigInt    @default(0) @map("total_igst")
  roundOff              BigInt    @default(0) @map("round_off")
  grandTotal            BigInt    @default(0) @map("grand_total")
  paidCash              BigInt    @default(0) @map("paid_cash")
  paidBank              BigInt    @default(0) @map("paid_bank")
  creditToSupplier      BigInt    @default(0) @map("credit_to_supplier")
  bankLedgerId          String?   @map("bank_ledger_id") @db.Uuid
  notes                 String?
  cancelReason          String?   @map("cancel_reason")
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz()
  cancelledBy           String?   @map("cancelled_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  branch             Branch              @relation(fields: [branchId], references: [id])
  supplier           Party               @relation(fields: [supplierId], references: [id])
  bankLedger         Ledger?             @relation(fields: [bankLedgerId], references: [id])
  lineItems          PurchaseLineItem[]
  paymentAllocations PaymentAllocation[]

  @@index([branchId, voucherDate])
  @@index([supplierId, voucherDate])
  @@index([bankLedgerId])
  @@map("purchases")
}

model PurchaseLineItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId        String   @map("purchase_id") @db.Uuid
  lineNumber        Int      @map("line_number")
  productId         String   @map("product_id") @db.Uuid
  supplierId        String   @map("supplier_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  purchaseDate      DateTime @map("purchase_date") @db.Date
  unitRate          BigInt   @map("unit_rate")
  billedQty         Decimal  @map("billed_qty") @db.Decimal(12, 3)
  freeQty           Decimal  @default(0) @map("free_qty") @db.Decimal(12, 3)
  discount          BigInt   @default(0)
  gstRate           Decimal  @map("gst_rate") @db.Decimal(5, 2)
  priceIncludesGst  Boolean  @map("price_includes_gst")
  taxClassification String   @map("tax_classification")
  hsnCode           String?  @map("hsn_code")
  productName       String?  @map("product_name")
  unitSymbol        String?  @map("unit_symbol")
  taxableValue      BigInt   @map("taxable_value")
  cgstAmount        BigInt   @default(0) @map("cgst_amount")
  sgstAmount        BigInt   @default(0) @map("sgst_amount")
  igstAmount        BigInt   @default(0) @map("igst_amount")
  lineTotal         BigInt   @map("line_total")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  supplier Party    @relation(fields: [supplierId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@index([branchId])
  @@index([supplierId, productId, purchaseDate(sort: Desc)])
  @@map("purchase_line_items")
}

model Payment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  voucherDate      DateTime  @map("voucher_date") @db.Date
  voucherNumber    String?   @map("voucher_number")
  financialYear    String?   @map("financial_year")
  direction        String
  partyId          String?   @map("party_id") @db.Uuid
  cashBankLedgerId String    @map("cash_bank_ledger_id") @db.Uuid
  counterLedgerId  String?   @map("counter_ledger_id") @db.Uuid
  amount           BigInt
  reference        String?
  notes            String?
  status           String    @default("confirmed")
  cancelReason     String?   @map("cancel_reason")
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz()
  cancelledBy      String?   @map("cancelled_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  branch         Branch              @relation(fields: [branchId], references: [id])
  party          Party?              @relation(fields: [partyId], references: [id])
  cashBankLedger Ledger              @relation("PaymentCashBankLedger", fields: [cashBankLedgerId], references: [id])
  counterLedger  Ledger?             @relation("PaymentCounterLedger", fields: [counterLedgerId], references: [id])
  allocations    PaymentAllocation[]

  @@index([branchId, voucherDate])
  @@index([partyId])
  @@index([cashBankLedgerId])
  @@index([counterLedgerId])
  @@map("payments")
}

model PaymentAllocation {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId  String  @map("payment_id") @db.Uuid
  saleId     String? @map("sale_id") @db.Uuid
  purchaseId String? @map("purchase_id") @db.Uuid
  amount     BigInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  payment  Payment   @relation(fields: [paymentId], references: [id])
  sale     Sale?     @relation(fields: [saleId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])

  @@index([paymentId])
  @@index([saleId])
  @@index([purchaseId])
  @@map("payment_allocations")
}

model LedgerPosting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ledgerId    String   @map("ledger_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  amount      BigInt
  voucherType String   @map("voucher_type")
  voucherId   String   @map("voucher_id") @db.Uuid
  voucherDate DateTime @map("voucher_date") @db.Date
  narration   String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  createdBy String?  @map("created_by") @db.Uuid

  ledger Ledger @relation(fields: [ledgerId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([ledgerId, voucherDate])
  @@index([branchId, voucherDate])
  @@index([voucherType, voucherId])
  @@map("ledger_postings")
}

model StockMovement {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  branchId            String   @map("branch_id") @db.Uuid
  quantityDelta       Decimal  @map("quantity_delta") @db.Decimal(12, 3)
  movementType        String   @map("movement_type")
  rate                BigInt
  value               BigInt
  voucherType         String   @map("voucher_type")
  voucherId           String   @map("voucher_id") @db.Uuid
  voucherDate         DateTime @map("voucher_date") @db.Date
  reason              String?
  referenceMovementId String?  @map("reference_movement_id") @db.Uuid
  avgCostAfter        BigInt?  @map("avg_cost_after")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  createdBy String?  @map("created_by") @db.Uuid

  product           Product         @relation(fields: [productId], references: [id])
  branch            Branch          @relation(fields: [branchId], references: [id])
  referenceMovement StockMovement?  @relation("StockMovementReversal", fields: [referenceMovementId], references: [id])
  reversals         StockMovement[] @relation("StockMovementReversal")

  @@index([branchId, productId, voucherDate])
  @@index([voucherType, voucherId])
  @@map("stock_movements")
}
