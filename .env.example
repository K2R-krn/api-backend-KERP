# Postgres connection pooled through Supabase's connection pooler (pgbouncer) — used by the app at runtime
# Append `&statement_timeout=10000` (10s) once transaction endpoints exist — the idempotency
# staleness-takeover (TDD §14.2) is only safe because no transaction can still be alive at the
# 60s mark, which this timeout guarantees (TDD §16). Not required yet (Iteration 2 has no
# write endpoints wired in), but don't forget it before Iteration 3.
DATABASE_URL="postgresql://user:password@localhost:6543/dbname?pgbouncer=true"

# Direct (unpooled) Postgres connection on port 5432 — used only for migrations
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# Secrets used to sign JWTs — generate with e.g. `openssl rand -hex 32`. Never commit real values.
JWT_ACCESS_SECRET="replace-with-a-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret"

# Token lifetimes (e.g. 15m, 7d)
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

PORT=3000
NODE_ENV=development

# --- Seed script (prisma/seed.ts) — required, never commit real values ---
SEED_BUSINESS_NAME="Your Business Trade Name"
SEED_BUSINESS_LEGAL_NAME="Your Registered Legal Name"
SEED_SUPER_ADMIN_USERNAME="superadmin"
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_PASSWORD="replace-with-a-strong-temporary-password"
SEED_SUPER_ADMIN_EMAIL=""
